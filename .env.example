# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

ENVIRONMENT=development
TZ=Europe/Moscow

# --- База данных (NFR-COMPLY-001: хранение на территории РФ, на серверах компании) ---
DATABASE_URL=postgresql+asyncpg://vacation_app:changeme@localhost:5432/vacation_tracker

# --- Redis / Celery (FR-NOTIF-002, FR-APPR-004 — напоминания и эскалации) ---
REDIS_URL=redis://localhost:6379/0

# --- Безопасность приложения (FR-AUTH-001) ---
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=14

# Ключ шифрования чувствительных полей (данные о больничных, NFR-SEC-001/002).
# Точный механизм (pgcrypto vs app-level) уточняется в рамках T-000 / T-M7-01 (см. plan.md §14).
FIELD_ENCRYPTION_KEY=changeme-32-byte-encryption-key

# --- Первичная служебная учётная запись администратора ---
# Нужна для входа в систему ДО того, как появится первая карточка сотрудника
# с ролью system_admin, сопоставленная через LDAP (см. FR-AUTH-002 — резервный
# локальный вход для служебных записей). Используется один раз при первом запуске
# для создания bootstrap-аккаунта администратора (auth_type = local).
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme

# --- SMTP для уведомлений (FR-NOTIF-001) ---
SMTP_HOST=smtp.company.local
SMTP_PORT=587
SMTP_USER=vacation-noreply@company.local
SMTP_PASSWORD=changeme
SMTP_FROM=vacation-noreply@company.local

# --- CORS (адрес frontend в dev-режиме) ---
CORS_ORIGINS=http://localhost:5173

# Примечание: параметры подключения к LDAP/Active Directory (FR-ADMIN-005, A-8)
# сознательно НЕ хранятся здесь — они настраиваются через интерфейс администратора
# приложения и сохраняются в таблице ldap_settings (см. plan.md §4, §5.2),
# чтобы их можно было менять без пересборки/передеплоя сервиса.
