# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в репозиторий (см. .gitignore).

ENVIRONMENT=development
TZ=Europe/Moscow

# --- База данных (NFR-COMPLY-001: хранение на территории РФ, на серверах компании) ---
# Значения ниже — "части", из которых backend/app/core/config.py собирает
# DATABASE_URL. Здесь они заданы для запуска с хоста (POSTGRES_HOST=localhost);
# в docker-compose backend/worker получают POSTGRES_HOST=postgres через
# environment сервиса (infra/docker-compose.yml) — он имеет приоритет над
# этим файлом, так что значения не расходятся.
POSTGRES_USER=vacation_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vacation_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Полный override — если задан, собранный из частей выше URL игнорируется.
# Используется в CI (.github/workflows/ci.yml), для локальной разработки
# не нужен.
# DATABASE_URL=postgresql+asyncpg://vacation_app:changeme@localhost:5432/vacation_tracker

# --- Redis / Celery (FR-NOTIF-002, FR-APPR-004 — напоминания и эскалации) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# Полный override — см. пояснение к DATABASE_URL выше.
# REDIS_URL=redis://localhost:6379/0

# --- Тестовый LDAP-каталог (T-M0-04, infra/docker-compose.yml) ---
# Пароль администратора контейнера openldap — не путать с учётными данными
# для подключения к боевому LDAP/AD: те настраиваются через интерфейс
# администратора и хранятся в таблице ldap_settings (см. ниже).
LDAP_ADMIN_PASSWORD=changeme

# --- Безопасность приложения (FR-AUTH-001) ---
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60

# Ключ обратимого шифрования на уровне приложения — используется только для
# пароля служебной записи LDAP (ldap_settings.bind_password_encrypted,
# FR-ADMIN-005). К данным о больничных НЕ применяется — решение T-000
# (см. requirements.md раздел 13, п. 11; plan.md §4/§9): защищаемый факт
# выражен структурой строки, а не значением поля, и колоночное шифрование
# его не скрывает. Поэтому потеря ключа означает лишь необходимость заново
# ввести пароль в интерфейсе администратора — потери данных не происходит.
LDAP_PASSWORD_ENCRYPTION_KEY=changeme-32-byte-encryption-key

# Бюджет ожидания одного обращения к LDAP-каталогу (T-M1-58) — без него
# подвисший, но ДОСТИЖИМЫЙ каталог (не остановленный — для остановленного
# ОС отвечает мгновенно) держит запрос неограниченно долго (измерено —
# 20 с против TCP-сервера, который принимал соединение и никогда не
# отвечал; ограничено только тем, когда сторонняя сторона сама сдалась).
# Целые секунды, не дробные — `ldap3`'s receive_timeout требует int
# (connect_timeout дробное принимает молча — асимметрия самой `ldap3`,
# но обоим полям нужна одна форма, через переменные окружения дробное
# значение недостижимо для обоих — см. ниже).
# Положительное число (>=1) — 0 и отрицательные значения проходили
# простую валидацию int, но ломали сам вызов тихо и по-разному (0 давал
# мгновенный отказ входа, неотличимый от неверного пароля; отрицательное
# значение — необработанное исключение вместо единообразного отказа);
# недопустимое значение теперь не даёт приложению стартовать.
# Общий механизм для входа пользователя и администраторской проверки, но
# НЕ одинаковый риск: вход (`authenticate`) открывает два соединения
# (bind служебной записью + поиск, затем bind от имени найденного
# пользователя), администраторская проверка — одно. PR #172 review
# измерил оба РЕЖИМА отказа против настоящего тестового каталога
# (см. T-M1-58 в docs/tasks.md, докстринг ldap_client.authenticate):
# при ЗАВИСШЕМ каталоге второе соединение не открывается вовсе — предел
# ОДНА фаза (5 с при значениях ниже), не сумма; при МЕДЛЕННОМ, НО
# ОТВЕЧАЮЩЕМ каталоге предел — сумма реальных LDAP-обменов (3 у входа,
# 2 у проверки, при get_info=ldap3.NONE, что на деле равно строке
# "NO_INFO", не "NONE" — без него ldap3 добавляет 2 лишних обмена на
# каждое соединение, см. тот же докстринг).
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_RECEIVE_TIMEOUT_SECONDS=5

# --- Первичная служебная учётная запись администратора ---
# Нужна для входа в систему ДО того, как появится первая карточка сотрудника
# с ролью system_admin, сопоставленная через LDAP (см. FR-AUTH-002 — резервный
# локальный вход для служебных записей). Используется один раз при первом запуске
# для создания bootstrap-аккаунта администратора (auth_type = local).
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme

# --- SMTP для уведомлений (FR-NOTIF-001) ---
SMTP_HOST=smtp.company.local
SMTP_PORT=587
SMTP_USER=vacation-noreply@company.local
SMTP_PASSWORD=changeme
SMTP_FROM=vacation-noreply@company.local

# --- CORS (адрес frontend в dev-режиме) ---
CORS_ORIGINS=http://localhost:5173

# Примечание: параметры подключения к LDAP/Active Directory (FR-ADMIN-005, A-8)
# сознательно НЕ хранятся здесь — они настраиваются через интерфейс администратора
# приложения и сохраняются в таблице ldap_settings (см. plan.md §4, §5.2),
# чтобы их можно было менять без пересборки/передеплоя сервиса.
